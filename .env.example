# Path to the device config file (default: ./mikrotik.config.json)
MIKROTIK_CONFIG=./mikrotik.config.json

# One password env var per device referenced by passwordEnv in the config
ROS_CORE_PASS=change-me
ROS_BRANCH_PASS=change-me

# Ollama / local Qwen bridge (examples/qwen-bridge.mjs)
OLLAMA_HOST=http://10.10.10.21:11434
# QWEN_MODEL=qwen3.5:4b
# QWEN_NUM_CTX=8192
# QWEN_THINK=false
# QWEN_TIMEOUT_MS=120000
